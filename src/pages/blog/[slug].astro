---
import type { GetStaticPaths } from "astro";
import Layout from "../../layouts/Layout.astro";
import BlogCard from "../../components/BlogCard.astro";
import {
  getPosts, formatDate, isoDate, readingTime, slugify, SITE, type Post,
} from "../../lib/blog";

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    // Powiązane: najpierw ta sama kategoria, potem najnowsze — dzięki temu
    // nawet pierwszy wpis w kategorii ma czym uzupełnić sekcję.
    props: {
      post,
      related: [
        ...posts.filter((p) => p.slug !== post.slug && p.data.category === post.data.category),
        ...posts.filter((p) => p.slug !== post.slug && p.data.category !== post.data.category),
      ].slice(0, 3),
    },
  }));
};

interface Props {
  post: Post;
  related: Post[];
}

const { post, related } = Astro.props;
const { title, description, category, publishDate, updateDate, author, tags, image, imageAlt } = post.data;
const { Content } = await post.render();
const url = `${SITE}/blog/${post.slug}/`;

const schema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: isoDate(publishDate),
  dateModified: isoDate(updateDate ?? publishDate),
  author: { "@type": "Organization", name: author },
  publisher: { "@type": "Organization", name: "Art Kuchnie Toruń", url: SITE },
  mainEntityOfPage: { "@type": "WebPage", "@id": url },
  ...(image ? { image: image.startsWith("http") ? image : `${SITE}${image}` } : {}),
};

const breadcrumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Strona główna", item: `${SITE}/` },
    { "@type": "ListItem", position: 2, name: "Blog", item: `${SITE}/blog/` },
    { "@type": "ListItem", position: 3, name: title, item: url },
  ],
};
---

<Layout title={`${title} | Art Kuchnie Toruń`} description={description} canonical={url}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbs)} is:inline />

  <article class="blog-post">
    <header class="blog-post__header">
      <div class="container container--narrow">
        <nav class="blog-breadcrumbs" aria-label="Ścieżka nawigacji">
          <a href="/">Strona główna</a>
          <span aria-hidden="true">/</span>
          <a href="/blog/">Blog</a>
          <span aria-hidden="true">/</span>
          <span>{category}</span>
        </nav>

        <a href={`/blog/kategoria/${slugify(category)}/`} class="blog-post__category">{category}</a>
        <h1 class="blog-post__title">{title}</h1>
        <p class="blog-post__lead">{description}</p>

        <div class="blog-post__meta">
          <time datetime={publishDate.toISOString()}>{formatDate(publishDate)}</time>
          <span aria-hidden="true">•</span>
          <span>{readingTime(post.body)} min czytania</span>
          {updateDate && (
            <>
              <span aria-hidden="true">•</span>
              <span>aktualizacja: {formatDate(updateDate)}</span>
            </>
          )}
        </div>
      </div>
    </header>

    {image && (
      <div class="container container--narrow">
        <img class="blog-post__cover" src={image} alt={imageAlt || title} width="1200" height="675" />
      </div>
    )}

    <div class="container container--narrow">
      <div class="blog-prose">
        <Content />
      </div>

      {tags.length > 0 && (
        <ul class="blog-tags" aria-label="Tagi">
          {tags.map((tag) => <li>#{tag}</li>)}
        </ul>
      )}
    </div>
  </article>

  {related.length > 0 && (
    <section class="section section--alt">
      <div class="container">
        <div class="section-header">
          <span class="section-label">Czytaj dalej</span>
          <h2 class="section-title">Powiązane artykuły</h2>
        </div>
        <div class="blog-grid">
          {related.map((p) => <BlogCard post={p} />)}
        </div>
      </div>
    </section>
  )}

  <section class="cta">
    <div class="container">
      <h2 class="cta__title">Zrobimy Ci taką kuchnię</h2>
      <p class="cta__text">
        Projekt, produkcja i montaż w Toruniu i okolicach. Wycena bez zobowiązań.
      </p>
      <div class="cta__buttons">
        <a href="/kontakt/" class="btn btn--primary">Umów bezpłatny pomiar</a>
        <a href="tel:+48576376567" class="btn btn--white">576 376 567</a>
      </div>
    </div>
  </section>
</Layout>
